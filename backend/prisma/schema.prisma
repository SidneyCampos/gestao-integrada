// Isso avisa ao Prisma que usaremos PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// MÓDULO CORE (GENÉRICO PARA TODA PREFEITURA)
// ==========================================

model Setor {
  id       Int       @id @default(autoincrement())
  nome     String    @unique // Ex: "Almoxarifado", "RH"
  usuarios Usuario[] // Relacionamento: Um setor tem vários usuários
}

model Usuario {
  id       Int     @id @default(autoincrement())
  nome     String
  telefone String? // A interrogação significa que é opcional

  // Ligação genérica com o setor
  setorId Int
  setor   Setor @relation(fields: [setorId], references: [id])

  // Dados de Login (se for nulo, ele não acessa o sistema)
  login     String? @unique
  senhaHash String? // Nunca salvamos a senha real, apenas o "hash" (criptografia)

  // Permissões
  isAdmin Boolean @default(false) // Apenas 1 será true

  // O que esse usuário fez?
  emprestimos Emprestimo[] // Relacionamento com almoxarifado
}

// ==========================================
// MÓDULO ALMOXARIFADO (CONTROLE DE FERRAMENTAS)
// ==========================================

model Ferramenta {
  id               Int     @id @default(autoincrement())
  nome             String
  codigoPatrimonio String? @unique // Caso a ferramenta tenha um código na plaquinha
  quantidadeTotal  Int
  qtdDisponivel    Int

  emprestimos Emprestimo[]
}

model Emprestimo {
  id            Int       @id @default(autoincrement())
  dataSaida     DateTime  @default(now()) // Pega a data atual automaticamente
  dataDevolucao DateTime? // Nulo significa que ainda está com o funcionário
  status        String    @default("PENDENTE") // Pode ser PENDENTE ou DEVOLVIDO

  // Quem pegou?
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  // O que pegou?
  ferramentaId Int
  ferramenta   Ferramenta @relation(fields: [ferramentaId], references: [id])
}
