// Isso avisa ao Prisma que usaremos PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// MÓDULO CORE (GENÉRICO PARA TODA PREFEITURA)
// ==========================================

model Setor {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  // Relação N:N (Muitos para Muitos) - O Prisma resolve a tabela intermediária sozinho!
  usuarios Usuario[]

  // Novos campos para vincular itens/ferramentas a setores específicos
  ferramentas Ferramenta[]
}

model Usuario {
  id       Int     @id @default(autoincrement())
  nome     String
  telefone String?
  setorExterno String? // Campo de texto livre para funcionários externos

  // Agora um usuário pode ter NENHUM, UM ou VÁRIOS setores!
  setores Setor[]

  // Dados de Login
  login String? @unique
  senha String? // Para simplificar agora, sem hash complexo.

  // Permissões e Tipo
  isAdmin   Boolean @default(false)
  isSistema Boolean @default(true) // Se for false, é um funcionário que só recebe coisas, não acessa o sistema.

  // O que esse usuário fez?
  emprestimos        Emprestimo[]
  requisicoesConsumo RequisicaoConsumo[]
}

// ==========================================
// MÓDULO ALMOXARIFADO (CONTROLE DE FERRAMENTAS)
// ==========================================

model Ferramenta {
  id               Int     @id @default(autoincrement())
  nome             String
  codigoPatrimonio String? @unique // Caso a ferramenta tenha um código na plaquinha
  quantidadeTotal  Int
  qtdDisponivel    Int

  // Novas propriedades para melhor organização e segurança
  categoria String? // Ex: 'Consumível', 'Ferramenta', 'Informática'
  
  // Vínculo com Setor: Se for nulo, é do Almoxarifado Geral. 
  // Se tiver um ID, apenas usuários desse setor (ou Admins) podem gerenciar.
  setorId Int?
  setor   Setor? @relation(fields: [setorId], references: [id])

  emprestimos Emprestimo[]
}

model Emprestimo {
  id            Int       @id @default(autoincrement())
  dataSaida     DateTime  @default(now())
  dataDevolucao DateTime?
  status        String    @default("PENDENTE")

  quantidade Int @default(1) // <--- NOVA LINHA AQUI

  usuarioId    Int
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
  ferramentaId Int
  ferramenta   Ferramenta @relation(fields: [ferramentaId], references: [id])
}

// ==========================================
// MÓDULO CONSUMO (LANÇAMENTO ÁGIL E ESTOQUE)
// ==========================================

model ProdutoConsumo {
  id                 Int      @id @default(autoincrement())
  nome               String
  categoria          String   @default("Geral") // Ex: 'Geral', 'Elétrica', 'TI'
  quantidadeEstoque  Float    @default(0)
  valorUnitarioAtual Float    @default(0) // Preço base para lançamentos

  itensRequisitados  ItemRequisicaoConsumo[]
}

model RequisicaoConsumo {
  id                  Int      @id @default(autoincrement())
  dataRegistro        DateTime @default(now())
  departamentoDestino String
  mesReferencia       String // ex: MARÇO/2026
  valorTotal          Float    @default(0)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  itens ItemRequisicaoConsumo[]
}

model ItemRequisicaoConsumo {
  id           Int               @id @default(autoincrement())
  requisicaoId Int
  requisicao   RequisicaoConsumo @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)

  // Opcional para manter compatibilidade com dados antigos
  produtoId    Int?
  produto      ProdutoConsumo?   @relation(fields: [produtoId], references: [id])

  descricaoProduto String // Mantido para histórico
  quantidade       Float
  valorUnitario    Float
  subtotal         Float
}
