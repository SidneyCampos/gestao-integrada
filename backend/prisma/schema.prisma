// Isso avisa ao Prisma que usaremos PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// MÓDULO CORE (GENÉRICO PARA TODA PREFEITURA)
// ==========================================

model Setor {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  // Relação N:N (Muitos para Muitos) - O Prisma resolve a tabela intermediária sozinho!
  usuarios Usuario[]
}

model Usuario {
  id       Int     @id @default(autoincrement())
  nome     String
  telefone String?

  // Agora um usuário pode ter NENHUM, UM ou VÁRIOS setores!
  setores Setor[]

  // Dados de Login
  login String? @unique
  senha String? // Para simplificar agora, sem hash complexo.

  // Permissões
  isAdmin Boolean @default(false)

  // O que esse usuário fez?
  emprestimos Emprestimo[]
}

// ==========================================
// MÓDULO ALMOXARIFADO (CONTROLE DE FERRAMENTAS)
// ==========================================

model Ferramenta {
  id               Int     @id @default(autoincrement())
  nome             String
  codigoPatrimonio String? @unique // Caso a ferramenta tenha um código na plaquinha
  quantidadeTotal  Int
  qtdDisponivel    Int

  emprestimos Emprestimo[]
}

model Emprestimo {
  id            Int       @id @default(autoincrement())
  dataSaida     DateTime  @default(now())
  dataDevolucao DateTime?
  status        String    @default("PENDENTE")

  quantidade Int @default(1) // <--- NOVA LINHA AQUI

  usuarioId    Int
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
  ferramentaId Int
  ferramenta   Ferramenta @relation(fields: [ferramentaId], references: [id])
}
